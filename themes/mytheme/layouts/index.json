{{- $.Scratch.Add "index" slice -}}
{{- range .Site.RegularPages -}}
  {{- $.Scratch.Add "index" (dict
    "title" .Title
    "summary" (.Params.summary | default "")
    "content" .Plain
    "url" .RelPermalink
    "section" .Type
    "country" (.Params.country | default (.Params.whscountry | default ""))
    "city" (.Params.city | default "")
    "period" (.Params.period | default "")
    "date" (.Date.Format "January 2006")
  ) -}}
{{- end -}}
{{- $.Scratch.Get "index" | jsonify -}}